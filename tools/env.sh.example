# Source this for CMSIS-Toolbox builds (WALDO-executorch).
export PATH=~/arm-tools/cmsis-toolbox-darwin-arm64/bin:~/alif/.venv/bin:$PATH
export GCC_TOOLCHAIN_14_3_1=~/arm-tools/arm-gnu-toolchain-14.3.rel1-darwin-arm64-arm-none-eabi/bin
export CMSIS_PACK_ROOT=~/.cache/arm/packs
export CMSIS_COMPILER_ROOT=~/arm-tools/cmsis-toolbox-darwin-arm64/etc
